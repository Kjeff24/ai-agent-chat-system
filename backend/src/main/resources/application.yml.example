spring:
  application:
    name: ai-agent-chat-system
  config:
    import: optional:file:.env[.properties]
  
  datasource:
    url: ${DATABASE_URL}
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    driver-class-name: org.postgresql.Driver
    # Optional: Uncomment to use H2 in-memory database for development
    # url: jdbc:h2:mem:ai_chat
    # driver-class-name: org.h2.Driver
  
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        format_sql: true
  
  data:
    redis:
      host: ${REDIS_HOST}
      port: ${REDIS_PORT}
      password: ${REDIS_PASSWORD}
  
  # Spring AI Configuration (static providers at startup).
  # Additional providers can be registered at runtime via POST /api/models/registry with optional models list and defaultModel.
  ai:
    openai:
      api-key: ${OPENAI_API_KEY}
      chat:
        options:
          model: ${OPENAI_MODEL}
          temperature: 0.7
          max-tokens: 2000
    
    anthropic:
      api-key: ${ANTHROPIC_API_KEY}
      chat:
        options:
          model: ${ANTHROPIC_MODEL}
          temperature: 0.7
          max-tokens: 2000
    
    # Excluded at startup (see ChatSystemApplication). Set in .env to have values; add via Settings → Model providers when needed.
    ollama:
      base-url: ${OLLAMA_BASE_URL:}
      chat:
        options:
          model: ${OLLAMA_MODEL:llama2}

server:
  port: ${PORT:8080}

jwt:
  secret: ${JWT_SECRET}
  expiration: ${JWT_EXPIRATION}
  refresh-expiration: ${JWT_REFRESH_EXPIRATION}

cors:
  allowed-origins: ${CORS_ORIGINS}

# Chat: system prompt. Static default from file; override via PUT /api/settings/system-prompt.
app:
  chat:
    # Path to system-prompt.md (classpath or file). Empty = no file default.
    system-prompt-path: ${APP_CHAT_SYSTEM_PROMPT_PATH}
  # MCP OAuth: for servers that use OAuth (e.g. Atlassian). Register app with provider and set callback URI there.
  mcp:
    oauth:
      callback-uri: ${APP_MCP_OAUTH_CALLBACK_URI}
      # OAuth providers: add map entries here or via Settings (MCP tab). Use {} when none.
      providers: {}
      # Example providers (uncomment and add under providers: above).
      # Atlassian Rovo MCP: use OAuth from https://mcp.atlassian.com/.well-known/oauth-authorization-server
      # (register your app / get client credentials from that MCP OAuth flow; add callback origin to Rovo "Your domains").
      #   atlassian:
      #     authorization-uri: https://mcp.atlassian.com/v1/authorize
      #     token-uri: https://cf.mcp.atlassian.com/v1/token
      #     client-id: ${ATLASSIAN_MCP_CLIENT_ID}
      #     client-secret: ${ATLASSIAN_MCP_CLIENT_SECRET}
      #     scopes: "openid"
      # Classic Atlassian Developer (auth.atlassian.com) alternative:
      #     authorization-uri: https://auth.atlassian.com/authorize
      #     token-uri: https://auth.atlassian.com/oauth/token
      #     scopes: "read:jira-work read:confluence-content.all offline_access"
      #   google:
      #     authorization-uri: https://accounts.google.com/o/oauth2/v2/auth
      #     token-uri: https://oauth2.googleapis.com/token
      #     client-id: ${GOOGLE_MCP_CLIENT_ID}
      #     client-secret: ${GOOGLE_MCP_CLIENT_SECRET}
      #     scopes: "openid email profile"

# MCP (Model Context Protocol): tools are discovered from each server at runtime. No tool list or input schema is configured.
# Add servers via Settings (MCP tab) or here. Create/update via POST/PUT /api/mcp/servers (name, url, optional headers/timeout, optional oauthProvider).
# Static servers can set oauth-provider (e.g. atlassian) to use OAuth; dynamic servers can send oauthProvider in the API body.
mcp:
  servers:
    # -------------------------------------------------------------------------
    # GitHub MCP (remote): repos, issues, PRs, code search. Requires GITHUB_PAT.
    # -------------------------------------------------------------------------
    github:
      url: https://api.githubcopilot.com/mcp/
      request-timeout-seconds: 30
      headers:
        Authorization: "Bearer ${GITHUB_PAT}"

    # -------------------------------------------------------------------------
    # Atlassian Rovo MCP: OAuth from https://mcp.atlassian.com/.well-known/oauth-authorization-server.
    # Configure app.mcp.oauth.providers.atlassian with authorization-uri/token-uri from that discovery doc.
    # Add callback origin (e.g. http://localhost:8080) to Atlassian Administration → Rovo MCP server → Your domains.
    # -------------------------------------------------------------------------
    # atlassian:
    #   url: https://mcp.atlassian.com/v1/mcp
    #   request-timeout-seconds: 30
    #   oauth-provider: atlassian

    # -------------------------------------------------------------------------
    # Example: Slack MCP (header-based)
    # -------------------------------------------------------------------------
    # slack:
    #   url: https://your-slack-mcp.example.com/mcp
    #   request-timeout-seconds: 30
    #   headers:
    #     Authorization: "Bearer ${SLACK_BOT_TOKEN}"

# SpringDoc OpenAPI / Swagger
springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui.html
    operationsSorter: method
    tagsSorter: alpha

logging:
  level:
    com.aiagent: DEBUG
    org.springframework.ai: DEBUG
    # MCP SDK: reduce noise from 405/404 when connecting (e.g. GitHub uses POST, not GET/SSE; some URLs 404)
    io.modelcontextprotocol.client.LifecycleInitializer: ERROR

