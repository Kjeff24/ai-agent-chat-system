# =============================================================================
# AI Agent Chat System - Environment Variables
# =============================================================================
# 1. Copy to .env:  cp .env.example .env
# 2. Edit .env and set your values.
# 3. Place .env in project root or in backend/ (where you run mvn spring-boot:run).
#    Spring Boot loads optional:file:.env[.properties] from the working directory.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8080

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/ai_chat
DB_USERNAME=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET=your-secret-key-change-in-production-min-256-bits
JWT_EXPIRATION=604800000
JWT_REFRESH_EXPIRATION=2592000000

# -----------------------------------------------------------------------------
# CORS (comma-separated origins for frontend)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:4200

# -----------------------------------------------------------------------------
# AI Providers (optional – app starts with Ollama only if others are unset)
# -----------------------------------------------------------------------------

# OpenAI – set to enable OpenAI models
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4

# Anthropic – set to enable Claude models
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-opus-20240229

# Ollama – local models (default base URL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
