# =============================================================================
# AI Agent Chat System - Environment Variables
# =============================================================================
# 1. Copy to .env:  cp .env.example .env
# 2. Replace placeholder values with real values.
# 3. Local dev: place .env in project root or backend/ (Spring Boot loads optional:file:.env[.properties]).
#    Docker:     place .env in project root (docker-compose picks it up via env_file: .env).
#                Use the Docker values noted below for DATABASE_URL, REDIS_HOST, REDIS_PORT.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8080

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Local dev: DATABASE_URL=jdbc:postgresql://localhost:5432/ai_chat
# Docker:    DATABASE_URL=jdbc:postgresql://postgres:5432/ai_chat
# -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/ai_chat
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# -----------------------------------------------------------------------------
# Redis
# Local dev: REDIS_HOST=localhost
# Docker:    REDIS_HOST=redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# -----------------------------------------------------------------------------
# JWT (required; use a long random secret in production)
# -----------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-min-256-bits-change-in-production-abc123xyz789
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# -----------------------------------------------------------------------------
# CORS (comma-separated origins for frontend)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# -----------------------------------------------------------------------------
# AI providers (optional – register at runtime via Settings if unset)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Ollama (optional – enable at startup by setting base URL; defaults below if unset)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
# AWS Bedrock (optional – or add Bedrock provider in Settings with access/secret key)
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Chat – system prompt file path (classpath: or file:)
# -----------------------------------------------------------------------------
APP_CHAT_SYSTEM_PROMPT_PATH=classpath:system-prompt.md

# -----------------------------------------------------------------------------
# MCP – GitHub (Bearer token). Set if using GitHub MCP in application.yml or Settings.
# -----------------------------------------------------------------------------
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# MCP OAuth – Atlassian (set if using Atlassian MCP with OAuth). Register app at Atlassian Developer.
# This URI must match EXACTLY what you register as the callback/redirect URI there (including http vs https, host, port, path). If you get an internal server error on the provider’s authorize page, the redirect_uri usually doesn’t match; try registering both localhost and 127.0.0.1 if needed.
# -----------------------------------------------------------------------------
APP_MCP_OAUTH_CALLBACK_URI=http://localhost:8080/api/mcp/servers/oauth/callback
ATLASSIAN_MCP_CLIENT_ID=your-atlassian-client-id
ATLASSIAN_MCP_CLIENT_SECRET=your-atlassian-client-secret
