# =============================================================================
# AI Agent Chat System - Environment Variables
# =============================================================================
# 1. Copy to .env:  cp .env.example .env
# 2. Edit .env and set your values.
# 3. Place .env in project root or in backend/ (where you run mvn spring-boot:run).
#    Spring Boot loads optional:file:.env[.properties] from the working directory.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8080

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/ai_chat
DB_USERNAME=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET=your-secret-key-change-in-production-min-256-bits
JWT_EXPIRATION=604800000
JWT_REFRESH_EXPIRATION=2592000000

# -----------------------------------------------------------------------------
# CORS (comma-separated origins for frontend)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:4200

# -----------------------------------------------------------------------------
# AI Providers (optional – app starts with Ollama only if others are unset)
# You can also register providers at runtime via Settings > Model providers (POST /api/models/registry) with a list of models and default.
# -----------------------------------------------------------------------------

# OpenAI – set to enable OpenAI models
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4

# Anthropic – set to enable Claude models
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-opus-20240229

# Ollama – local models (default base URL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# -----------------------------------------------------------------------------
# MCP (Model Context Protocol) – optional context from external tools
# MCP is auto-enabled when at least one server exists (application.yml or Settings > MCP servers).
# To inject tool results into chat, set MCP_DEFAULT_CONTEXT_TOOL (single or comma-separated list).
# Each tool is called with your message as "query"; results are combined and injected as context.
# -----------------------------------------------------------------------------
# Single tool (GitHub MCP: search_repositories, search_code, search_issues – tool names are server-specific):
# MCP_DEFAULT_CONTEXT_TOOL=search_repositories
# Multiple tools (comma-separated; use only tools your MCP server exposes):
# MCP_DEFAULT_CONTEXT_TOOL=search_repositories,search_code

# GitHub MCP – remote server (repos, issues, PRs, code search). Requires PAT with repo scope.
# Configure in application.yml under mcp.servers.github or add via Settings > MCP servers.
# Create token at: https://github.com/settings/tokens/new (scopes: repo, read:org)
# GITHUB_PAT=ghp_your_github_personal_access_token
